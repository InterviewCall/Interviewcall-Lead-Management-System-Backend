<html lang='en'>
    <body
        style="margin:0;padding:0;background:#f4f5f7;font-family:-apple-system,BlinkMacSystemFont,'Segoe UI',Roboto,Helvetica,Arial,sans-serif;color:#1f2937;"
    >
        <table
            role='presentation'
            width='100%'
            cellpadding='0'
            cellspacing='0'
            style='background:#f4f5f7;padding:32px 16px;'
        >
            <tr>
                <td align='center'>
                    <table
                        role='presentation'
                        width='560'
                        cellpadding='0'
                        cellspacing='0'
                        style='max-width:560px;width:100%;background:#ffffff;border-radius:12px;overflow:hidden;'
                    >
                        <tr>
                            <td
                                style='background:#1e1b4b;padding:24px 32px;color:#ffffff;font-size:18px;font-weight:600;'
                            >InterviewCall CRM</td>
                        </tr>
                        <tr>
                            <td style='padding:32px;'>
                                <p style='margin:0 0 16px;font-size:16px;'>Hi
                                    {{name}},</p>
                                <p
                                    style='margin:0 0 24px;font-size:15px;line-height:1.6;'
                                >An admin created your InterviewCall CRM
                                    account. You have been added as
                                    <strong>{{role}}</strong>.</p>
                                <table
                                    role='presentation'
                                    width='100%'
                                    cellpadding='0'
                                    cellspacing='0'
                                    style='background:#f4f5f7;border-radius:8px;margin:0 0 24px;'
                                >
                                    <tr>
                                        <td
                                            style='padding:16px 20px;font-size:14px;line-height:1.5;'
                                        >
                                            <div
                                                style='color:#6b7280;font-size:12px;text-transform:uppercase;letter-spacing:.04em;'
                                            >Email</div>
                                            <div
                                                style='margin:2px 0 14px;'
                                            >{{email}}</div>
                                            <div
                                                style='color:#6b7280;font-size:12px;text-transform:uppercase;letter-spacing:.04em;'
                                            >Temporary password</div>
                                            <div
                                                style="margin-top:2px;font-family:Menlo,Consolas,'Courier New',monospace;font-size:17px;letter-spacing:.04em;"
                                            >{{temporaryPassword}}</div>
                                        </td>
                                    </tr>
                                </table>
                                <p style='margin:0 0 24px;'>
                                    <a
                                        href='{{loginUrl}}'
                                        style='display:inline-block;background:#4f46e5;color:#ffffff;text-decoration:none;font-size:15px;font-weight:600;padding:12px 24px;border-radius:8px;'
                                    >Sign in</a>
                                </p>
                                <p
                                    style='margin:0 0 16px;font-size:14px;line-height:1.6;'
                                >The first time you sign in you will be asked to
                                    choose your own password. Your account is
                                    activated once you have done that, and the
                                    temporary password stops working.</p>
                                <p
                                    style='margin:0;font-size:13px;line-height:1.6;color:#6b7280;'
                                >If you were not expecting this email, ignore
                                    it. Never share your password with anyone.</p>
                            </td>
                        </tr>
                    </table>
                </td>
            </tr>
        </table>
    </body>
</html>