# ---- crm-api and crm-worker ----
PORT=3000

# MySQL (the CRM database). DATABASE_URL is used by the Prisma CLI; the DB_* values by the app.
DATABASE_URL=mysql://crm_app:change-me@localhost:3306/crm
DB_HOST=localhost
DB_PORT=3306
DB_USER=crm_app
DB_PASSWORD=change-me
DB_NAME=crm

# Redis: BullMQ queues only. Same settings as the booking Redis: append-only, no eviction.
REDIS_URL=redis://localhost:6379

# ---- staff sessions (iam) ----
# The access token lives 15 minutes; the refresh token 7 days and rotates on every use.
# At least 32 characters. Generate one with: openssl rand -base64 48
ACCESS_TOKEN_SECRET=change-me-to-a-long-random-string
ACCESS_TOKEN_TTL_MINUTES=15
REFRESH_TOKEN_TTL_DAYS=7
# The web app origin allowed to send credentialed requests, and the parent domain for the cookies.
# Leave COOKIE_DOMAIN empty locally (host-only cookies); in production use the shared parent domain.
CRM_WEB_ORIGIN=http://localhost:3002
COOKIE_DOMAIN=

# ---- email (worker only) ----
# Staff invites go out through Amazon SES. EMAIL_FROM must be an address or domain verified in SES.
# While the SES account is in sandbox mode it can only send to verified addresses.
# Credentials come from the usual AWS settings: AWS_ACCESS_KEY_ID and AWS_SECRET_ACCESS_KEY, or an instance role.
AWS_REGION=ap-south-1
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
EMAIL_FROM=InterviewCall CRM <crm@interviewcall.club>
# Optional: where replies go, if not to EMAIL_FROM. One address or several separated by commas.
# A display name is fine (Name <a@b.com>) but must not contain a comma.
EMAIL_REPLY_TO=
# Optional: an SES configuration set, for bounce and complaint tracking.
SES_CONFIGURATION_SET=

# ---- intake ----
# Shared secret for the nightly pull from the three source services. Separate from source API keys.
RECONCILIATION_SECRET=change-me

# ---- seed (npm run seed) ----
SEED_ADMIN_NAME=Admin
SEED_ADMIN_EMAIL=admin@example.com
SEED_ADMIN_PASSWORD=change-me-at-least-12-chars

# Number of proxies in front of the API (1 behind a single load balancer or nginx). Leave unset locally.
# Needed for correct client IPs in rate limiting and the audit log.
TRUST_PROXY=
