# ---- crm-api and crm-worker ----
PORT=3000

# MySQL (the CRM database). DATABASE_URL is used by the Prisma CLI; the DB_* values by the app.
DATABASE_URL=mysql://crm_app:change-me@localhost:3306/crm
DB_HOST=localhost
DB_PORT=3306
DB_USER=crm_app
DB_PASSWORD=change-me
DB_NAME=crm

# Redis: BullMQ queues only. Same settings as the booking Redis: append-only, no eviction.
REDIS_URL=redis://localhost:6379

# ---- staff sessions (iam) ----
# The access token lives 15 minutes; the refresh token 7 days and rotates on every use.
ACCESS_TOKEN_SECRET=change-me-to-a-long-random-string
ACCESS_TOKEN_TTL_MINUTES=15
REFRESH_TOKEN_TTL_DAYS=7
# The web app origin allowed to send credentialed requests, and the parent domain for the cookies.
CRM_WEB_ORIGIN=http://localhost:3002
COOKIE_DOMAIN=localhost

# ---- intake ----
# Shared secret for the nightly pull from the three source services. Separate from source API keys.
RECONCILIATION_SECRET=change-me

# ---- seed (npm run seed) ----
SEED_ADMIN_NAME=Admin
SEED_ADMIN_EMAIL=admin@example.com
SEED_ADMIN_PASSWORD=change-me-at-least-12-chars
